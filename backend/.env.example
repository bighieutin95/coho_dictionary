PORT=3000
NODE_ENV=production

# Chuỗi kết nối Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Email tài khoản mặc định được tự động trao quyền ADMIN
ADMIN_EMAIL=admin@example.com
