{
  "name": "coho-dictionary-monorepo",
  "version": "1.0.0",
  "description": "Webapp tra cứu tự điển tiếng K'Ho - Việt trên nền tảng Supabase và Vercel",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start": "npm run start:prod --workspace=backend"
  },
  "keywords": [
    "koho",
    "coho",
    "dictionary",
    "tudien",
    "nestjs",
    "react",
    "supabase",
    "vercel"
  ],
  "author": "Bùi Gia Hiếu Tín",
  "license": "MIT"
}
